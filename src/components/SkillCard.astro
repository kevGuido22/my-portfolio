---
interface Props{
    img: string,
    title: string
}

const { img, title } = Astro.props;

---

<div
    class="w-28 flex flex-col justify-center items-center gap-2 p-4 rounded-card bg-surface border"
>
    <img src={img} alt={`${title}-image`} class="h-10 aspect-square object-contain">
    <p class="text-primary">{title}</p>
</div>
