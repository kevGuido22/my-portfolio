---
interface Props {
    img: string;
    title: string;
    index: string;
    width?: number;
    height?: number;
}

const { img, title, index, width, height } = Astro.props;
---

<!-- Index row: mono counter + grayscale brand icon + technology name.
     The icon is decorative (the name is adjacent visible text), so it
     carries an empty alt. -->
<li
    class="flex items-center gap-3 border-b px-2 py-3.5 break-inside-avoid transition-colors duration-200 hover:bg-surface sm:gap-4 sm:px-3"
>
    <span class="w-7 font-mono text-xs text-secondary">{index}</span>
    <img
        src={img}
        alt=""
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="h-6 w-6 flex-none object-contain grayscale"
    />
    <span class="font-primary text-base text-primary">{title}</span>
</li>
