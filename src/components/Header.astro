---
import { LinkedInIcon, ResumeIcon, GithubIcon } from "../icons/icons";
---

<header class="h-screen m-auto relative p-4">
    <div class="grid sm:grid-cols-2 items-center h-full max-w-screen-lg m-auto gap-8">
        <div class="flex flex-col justify-center sm:items-start sm:order-1 order-2">
            <h1 class="text-white text-5xl sm:text-6xl font-bold font-primary text-center sm:text-start">
                KEVIN GUIDO
            </h1>
            <div class="w-16 h-1 bg-gold mb-6"></div>
            <p class="text-text-secondary text-xl font-primary mb-2">
                SOFTWARE ENGINEER
            </p>
            <p class="text-text-secondary text-lg font-primary mb-6">
                I BUILD DIGITAL EXPERIENCES.
            </p>
            <span class="text-gold text-sm font-primary mb-8 tracking-wider">
                Java · Spring Boot · React · AWS
            </span>
            <div class="flex flex-col gap-4 sm:flex-row">
                <a
                    href="https://github.com/kevGuido22"
                    class="flex gap-2 items-center hover:text-gold transition-colors duration-300 text-text-secondary"
                    target="_blank"
                >
                    <GithubIcon /> GitHub
                </a>
                <a
                    href="https://www.linkedin.com/in/kevin-guido-urbina-2456aa280/"
                    class="flex gap-2 items-center hover:text-gold transition-colors duration-300 text-text-secondary"
                    target="_blank"
                >
                    <LinkedInIcon /> LinkedIn
                </a>
                <a
                    href="/CV.pdf"
                    class="flex gap-2 items-center hover:text-gold transition-colors duration-300 text-text-secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <ResumeIcon /> Resume
                </a>
            </div>
        </div>
        <div class="flex flex-col items-center justify-center sm:order-2 order-1">
            <img
                src="/images/profile.webp"
                alt="Portrait of Kevin Guido, Software Engineer"
                class="w-56 aspect-square object-cover object-top border border-white/10 hover:border-gold transition-colors duration-300 hover:-translate-y-1 rounded-lg"
            />
            <p class="text-text-muted text-sm font-primary mt-4 tracking-wider">
                COSTA RICA · 2026
            </p>
        </div>
    </div>
</header>