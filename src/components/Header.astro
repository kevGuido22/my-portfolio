---
import { LinkedInIcon, ResumeIcon, GithubIcon } from "../icons/icons";

const pillClasses =
    "flex items-center gap-2 rounded-chip border px-4 py-2 font-mono text-base uppercase tracking-[0.15em] text-secondary transition-colors duration-200 hover:border-primary hover:bg-primary hover:text-on-dark [&_svg]:h-4 [&_svg]:w-4";
---

<section
    id="home"
    class="relative flex min-h-svh flex-col gap-4 overflow-hidden px-4 pb-6 pt-16 sm:gap-6"
>
    <!-- Layer 0: technical grid (hairlines) -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 flex justify-center px-4"
    >
        <div
            class="grid h-full w-full max-w-screen-lg grid-cols-2 border-x lg:grid-cols-4"
        >
            <span class="border-r"></span>
            <span class="hidden border-r lg:block"></span>
            <span class="hidden border-r lg:block"></span>
            <span class="hidden lg:block"></span>
        </div>
    </div>

    <!-- Layer 0: typography as background (two stacked words, bleed) -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 select-none"
    >
        <p
            class="absolute left-1/2 top-1/2 w-max -translate-x-1/2 -translate-y-1/2 text-center font-primary text-[clamp(4rem,17vw,15rem)] font-bold uppercase leading-[0.9] tracking-wide text-primary opacity-10 flex flex-col md:gap-10"
        >
            <span class="block">Software</span>
            <span class="block">Engineer</span>
        </p>
    </div>

    <!-- HUD: top corners -->
    <div
        aria-hidden="true"
        class="relative z-20 mx-auto flex w-full max-w-screen-lg items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.2em] text-secondary"
        data-reveal
    >
        <span>01 / Hero</span>
        <span class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
            System.online
        </span>
    </div>

    <!-- Main composition -->
    <div
        class="relative z-10 mx-auto grid w-full max-w-screen-lg flex-1 grid-cols-1 items-center gap-8 sm:grid-cols-[7fr_5fr] sm:gap-10 lg:gap-16"
    >
        <div class="relative z-20 flex flex-col gap-8">
            <h1
                class="text-balance font-primary font-bold text-primary leading-[1.05] tracking-tight text-[clamp(2.75rem,8vw,6.5rem)] sm:-mr-16"
                data-reveal
            >
                Kevin Guido Urbina
            </h1>
            <div class="flex flex-wrap gap-3 text-md" data-reveal>
                <a
                    href="https://github.com/kevGuido22"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={pillClasses}
                >
                    <GithubIcon /> GitHub
                </a>
                <a
                    href="https://www.linkedin.com/in/kevin-guido-urbina/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={pillClasses}
                >
                    <LinkedInIcon /> LinkedIn
                </a>
                <a
                    href="/CV-KevinGuidoUrbina.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={pillClasses}
                >
                    <ResumeIcon /> Resume
                </a>
            </div>
        </div>

        <!-- Cutout portrait: stands on the slide baseline, in front of the type -->
        <figure
            class="relative z-10 mx-auto w-full max-w-[13rem] sm:mx-0 sm:max-w-none sm:-mb-6 sm:-ml-6 sm:self-end lg:-ml-10"
            data-reveal
        >
            <img
                src="/images/Profile.png"
                alt="Portrait of Kevin Guido, software developer"
                width="720"
                height="1280"
                fetchpriority="high"
                decoding="async"
                class="h-auto w-full grayscale"
            />
        </figure>
    </div>

    <!-- HUD: bottom corners -->
    <div
        aria-hidden="true"
        class="relative z-20 mx-auto flex w-full max-w-screen-lg items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.2em] text-secondary"
        data-reveal
    >
        <span class="flex items-center gap-2">Scroll <span>↓</span></span>
        <span>K. Guido</span>
    </div>
</section>
