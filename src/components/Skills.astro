---
import SkillCard from "./SkillCard.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section
    id="skills"
    class="px-4 py-16 lg:py-0 lg:flex lg:flex-col lg:justify-center"
>
    <div class="max-w-screen-lg m-auto w-full gap-2 grid">
        <SectionHeading index="04" title="Skills" />
        <div class="flex flex-row flex-wrap gap-4 mt-4 w-full">
            <SkillCard
                title={"HTML"}
                img={"/images/html-icon.png"}
            />
            <SkillCard title={"CSS"} img={"/images/css-icon.png"} />
            <SkillCard
                title={"JavaScript"}
                img={"/images/js-icon.png"}
            />
            <SkillCard
                title={"Typescript"}
                img={"/images/TS-icon.png"}
            />
            <SkillCard
                title={"React"}
                img={"/images/react-icon.png"}
            />
            <SkillCard
                title={"SASS"}
                img={"/images/sass-icon.png"}
            />
            
            
            <SkillCard
                title={"TailwindCSS"}
                img={"/images/tailwindcss-icon.png"}
            />
            <SkillCard title={"PHP"} img={"/images/php-icon.png"} />
            <SkillCard
                title={"Laravel"}
                img={"/images/laravel-icon.png"}
            />
            <SkillCard
                title={"MySQL"}
                img={"/images/sql-icon.png"}
            />
            <!-- <SkillCard
                title={"Figma"}
                img={"/images/figma-icon.png"}
            /> -->
            
            <SkillCard
                title={"Java"}
                img={"/images/Java-icon.png"}
            />
            <SkillCard
                title={"SpringBoot"}
                img={"/images/SpringBoot-icon.png"}
            />
            <SkillCard
                title={"Docker"}
                img={"/images/Docker-icon.png"}
            />
        </div>
    </div>
</section>
