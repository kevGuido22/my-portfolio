---
import SkillCard from "./SkillCard.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section
    id="skills"
    class="relative flex flex-col gap-4 overflow-hidden px-4 pb-6 pt-16 sm:gap-6 lg:pt-0"
>
    <!-- Layer 0: technical grid (hairlines) -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 flex justify-center px-4"
    >
        <div
            class="grid h-full w-full max-w-screen-lg grid-cols-2 border-x lg:grid-cols-4"
        >
            <span class="border-r"></span>
            <span class="hidden border-r lg:block"></span>
            <span class="hidden border-r lg:block"></span>
            <span class="hidden lg:block"></span>
        </div>
    </div>

    <!-- Layer 0: typography as background (single word, bleed). The index
         rows are transparent by default, so the wordmark sits behind the
         names at 10% opacity — quiet enough to keep the list readable. -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 select-none"
    >
        <p
            class="absolute left-1/2 top-1/2 w-max -translate-x-1/2 -translate-y-1/2 text-center font-primary text-[clamp(4rem,15vw,13rem)] font-bold uppercase leading-[0.9] tracking-wide text-primary opacity-10"
        >
            Skills
        </p>
    </div>

    <!-- HUD: top corners -->
    <div
        aria-hidden="true"
        class="relative z-20 mx-auto flex w-full max-w-screen-lg items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.2em] text-secondary"
        data-reveal
    >
        <span>04 / Skills</span>
        <span class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
            Stack
        </span>
    </div>

    <!-- Index list (owns the slide center): an editorial index instead of
         the Projects bento — hairline rows with mono counters, balanced in
         two column-major columns on large screens like a book index. -->
    <div
        class="relative z-10 mx-auto flex w-full max-w-screen-lg flex-1 flex-col justify-center pt-8 lg:pt-0"
    >
        <div>
            <SectionHeading index="04" title="Skills" />
            <ol class="columns-1 gap-x-12 lg:columns-2" data-reveal>
                <SkillCard
                    index="01"
                    title={"HTML"}
                    img={"/images/html-icon.png"}
                    width={128}
                    height={129}
                />
                <SkillCard
                    index="02"
                    title={"CSS"}
                    img={"/images/css-icon.png"}
                    width={128}
                    height={129}
                />
                <SkillCard
                    index="03"
                    title={"JavaScript"}
                    img={"/images/js-icon.png"}
                    width={128}
                    height={129}
                />
                <SkillCard
                    index="04"
                    title={"Typescript"}
                    img={"/images/TS-icon.png"}
                    width={32}
                    height={32}
                />
                <SkillCard
                    index="05"
                    title={"React"}
                    img={"/images/react-icon.png"}
                    width={128}
                    height={115}
                />
                <SkillCard
                    index="06"
                    title={"SASS"}
                    img={"/images/sass-icon.png"}
                    width={128}
                    height={97}
                />
                <SkillCard
                    index="07"
                    title={"TailwindCSS"}
                    img={"/images/tailwindcss-icon.png"}
                    width={128}
                    height={78}
                />
                <SkillCard
                    index="08"
                    title={"PHP"}
                    img={"/images/php-icon.png"}
                    width={128}
                    height={68}
                />
                <SkillCard
                    index="09"
                    title={"Laravel"}
                    img={"/images/laravel-icon.png"}
                    width={128}
                    height={132}
                />
                <SkillCard
                    index="10"
                    title={"MySQL"}
                    img={"/images/sql-icon.png"}
                    width={128}
                    height={129}
                />
                <!-- <SkillCard
                    index="11"
                    title={"Figma"}
                    img={"/images/figma-icon.png"}
                    width={128}
                    height={193}
                /> -->
                <SkillCard
                    index="11"
                    title={"Java"}
                    img={"/images/Java-icon.png"}
                    width={32}
                    height={44}
                />
                <SkillCard
                    index="12"
                    title={"SpringBoot"}
                    img={"/images/SpringBoot-icon.png"}
                    width={32}
                    height={29}
                />
                <SkillCard
                    index="13"
                    title={"Docker"}
                    img={"/images/Docker-icon.png"}
                    width={32}
                    height={23}
                />
            </ol>
        </div>
    </div>

    <!-- HUD: bottom corners -->
    <div
        aria-hidden="true"
        class="relative z-20 mx-auto flex w-full max-w-screen-lg items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.2em] text-secondary"
        data-reveal
    >
        <span class="flex items-center gap-2">Scroll <span>↓</span></span>
        <span>K. Guido</span>
    </div>
</section>
