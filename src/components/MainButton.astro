---
interface Props {
    text: string;
    web: string | null;
}

const { text, web } = Astro.props;
---


<a
    href={web}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-fit items-center justify-center gap-2 rounded-chip border px-4 py-2 font-mono text-sm uppercase tracking-[0.15em] text-secondary transition-colors duration-200 hover:border-primary hover:bg-primary hover:text-on-dark [&_svg]:h-4 [&_svg]:w-4"
>
    {text}
    <slot />
</a>
