---
interface Props {
    text: string;
    web: string | null;
}

const { text, web } = Astro.props;
---


<a
    href={web}
    class="h-fit py-3 px-4 text-primary cursor-pointer bg-transparent border rounded-card flex gap-2 justify-center transition-colors duration-200 hover:bg-primary hover:text-background"
>
    {text}
    <slot />
</a>
