---
import Tag from "./Tag.astro";
import MainButton from "./MainButton.astro";
import { WebIcon } from "../icons/icons";
import { GithubIcon } from "../icons/icons";

interface Props {
    img: string;
    title: string;
    description: string;
    tags: Array<string>;
    web?: string;
    gitHub?: string;
    width?: number;
    height?: number;
}

const { title, img, description, tags, web, gitHub, width, height } = Astro.props;
---

<!-- Featured bento tile: stacked (image over text) below lg, side-by-side
     (text 3fr / image 2fr) from lg up — the internal split only exists where
     the 7-column tile is wide enough for two comfortable columns. -->
<div
    class="flex h-full flex-col overflow-hidden rounded-card border bg-surface transition-colors duration-300 hover:border-strong lg:grid lg:grid-cols-[3fr_2fr]"
>
    <div class="order-1 lg:order-2">
        <img
            src={img}
            alt={`Screenshot of the ${title} project`}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-left grayscale"
        />
    </div>
    <div class="order-2 flex flex-col p-5 sm:p-6 lg:order-1">
        <h3 class="text-primary font-primary text-xl font-semibold">
            {title}
        </h3>
        <p class="text-secondary font-primary mt-2 text-sm leading-relaxed">
            {description}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => <Tag name={tag} />)}
        </div>
        <div
            class="mt-auto grid grid-cols-[repeat(auto-fit,_minmax(150px,_1fr))] gap-2 pt-6"
        >
            {
                web ? (
                    <MainButton text="Website" web={web}>
                        <WebIcon />
                    </MainButton>
                ) : null
            }
            {
                gitHub ? (
                    <MainButton text="GitHub" web={gitHub}>
                        <GithubIcon />
                    </MainButton>
                ) : null
            }
        </div>
    </div>
</div>
