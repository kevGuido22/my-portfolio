---
interface Props {
    index: string;
    title: string;
    tone?: "light" | "dark";
}

const { index, title, tone = "light" } = Astro.props;

const isDark = tone === "dark";
---

<div class="mb-8 md:mb-10" data-reveal>
    <div class="flex items-center gap-4">
        <span
            class:list={[
                "font-mono text-xs tracking-[0.15em]",
                isDark ? "text-on-dark-secondary" : "text-secondary",
            ]}
        >
            {index}
        </span>
        <!-- Tailwind 3.4 cannot compile opacity modifiers on var() colors:
             bg-primary/10 was a dead class (invisible hairline). Element
             opacity on a token color produces the same hairline safely. -->
        <span
            class:list={[
                "h-px flex-1",
                isDark ? "bg-on-dark opacity-20" : "bg-primary opacity-10",
            ]}
            aria-hidden="true"></span>
    </div>
    <h2
        class:list={[
            "mt-4 font-primary font-semibold leading-[1.1] text-[clamp(2rem,4vw,3.5rem)]",
            isDark ? "text-on-dark" : "text-primary",
        ]}
    >
        {title}
    </h2>
</div>
