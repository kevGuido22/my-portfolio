            class="hidden font-mono text-xs uppercase tracking-[0.2em] text-secondary sm:block"
        >
            K. Guido
        </span>
        <!-- Copyright kept verbatim (no uppercase transform, no rewording) -->
        <p class="font-mono text-xs tracking-[0.15em] text-secondary">
            @2026 Kevin Guido Urbina
        </p>
        
        <div class="flex md:flex-col gap-2">
             <a
            href="/CV-KevinGuidoUrbina.pdf"
            target="_blank"
